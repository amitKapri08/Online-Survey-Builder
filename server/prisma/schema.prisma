generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  role Role @default(USER)

  surveys   Survey[]
  responses Response[]

  refreshSessions RefreshSession[]

  adminAuditLogs AdminAuditLog[]

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  actorId   String
  action    String
  targetId  String?
  details   Json?
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([targetId])
  @@index([createdAt])
}

model RefreshSession {
  id        String    @id @default(uuid())
  userId    String
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model Survey {
  id                     String       @id @default(uuid())
  title                  String
  description            String?
  slug                   String       @unique
  allowMultipleResponses Boolean      @default(false)
  viewCount              Int          @default(0)
  status                 SurveyStatus @default(DRAFT)
  isAnonymous            Boolean      @default(false)
  publishedAt            DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  questions   Question[]
  responses   Response[]
  surveyViews SurveyView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([status, updatedAt])
}

model SurveyView {
  id         String   @id @default(uuid())
  surveyId   String
  visitorKey String
  createdAt  DateTime @default(now())

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([surveyId, visitorKey])
  @@index([surveyId])
}

model Question {
  id           String       @id @default(uuid())
  questionText String
  questionType QuestionType
  isRequired   Boolean      @default(false)
  position     Int
  minValue     Int?
  maxValue     Int?

  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  options QuestionOption[]
  answers Answer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([surveyId])
}

model QuestionOption {
  id         String @id @default(uuid())
  optionText String
  position   Int

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answers Answer[]

  createdAt DateTime @default(now())

  @@index([questionId])
}

model Response {
  id String @id @default(uuid())

  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Stable per-respondent key for duplicate enforcement.
  /// Authenticated: "user:<userId>"; anonymous: "anon:<sha256(visitorId)>".
  responderKey String?

  answers Answer[]

  createdAt DateTime @default(now())

  @@index([surveyId])
  @@index([surveyId, createdAt])
  @@index([userId])
  // One response per survey per responder when allowMultipleResponses=false.
  // NULL responderKey (allowMultipleResponses=true) stays dedupe-free.
  @@unique([surveyId, responderKey])
}

model Answer {
  id String @id @default(uuid())

  responseId String
  response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)

  questionId String?
  question   Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  optionId String?
  option   QuestionOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  answerText   String?
  answerNumber Float?
  answerDate   DateTime?

  /// Historical snapshots preserved at submission time so results/exports
  /// remain readable even if the question/option is later edited or deleted.
  questionTextSnapshot     String?
  optionTextSnapshot       String?
  questionPositionSnapshot Int?

  createdAt DateTime @default(now())

  @@index([responseId])
  @@index([questionId])
  @@index([optionId])
}

enum SurveyStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  DROPDOWN
  RATING
  YES_NO
  NUMBER
  DATE
}

enum Role {
  USER
  ADMIN
}
