# Server environment template. Copy to `.env` for local development.
PORT=8000
NODE_ENV=development

# PostgreSQL connection string.
# Render's "Internal Database URL" is recommended for the deployed service.
DATABASE_URL=postgresql://user:password@localhost:5432/surveyhub

# Must be at least 32 characters when NODE_ENV=production.
JWT_SECRET=replace-with-a-long-random-string

JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Comma-separated list of allowed browser origins. No trailing slash.
# Production example: https://surveyhub.vercel.app
CORS_ORIGIN=http://localhost:5173

# Cookie cross-site policy.
#   lax  -> client and API share a site (same domain or a Vercel/Render proxy)
#   none -> client and API are on different sites (e.g. *.vercel.app + *.onrender.com)
# `none` requires HTTPS and is therefore only valid when NODE_ENV=production.
# Defaults to `none` in production and `lax` everywhere else.
COOKIE_SAME_SITE=lax
